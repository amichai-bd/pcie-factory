#!/usr/bin/env bash
# Fake ORFS make for tools/asic unit tests. Understands the arguments
# ./build asic passes (-C DIR, NAME=VALUE, one target) and copies the fixture
# reports under tests/fixtures/orfs/ into WORK_HOME like the real flow.
# FAKE_MAKE: ok (default) | fail (exit 3) | faillog (print fixtures/flow_fail.log, exit 2)
# | sleep (hang) | noextra (no asic_extra.json)
# | noclocks (asic_clocks.json with an empty clocks entry) | clocksfail (the clocks
# step exits 3, no asic_clocks.json) | clockssleep (the clocks step hangs).
set -euo pipefail
echo "fake make $*"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/orfs"
target=""
for arg in "$@"; do
  case "$arg" in
    DESIGN_CONFIG=*) cfg="${arg#*=}" ;;
    WORK_HOME=*) work="${arg#*=}" ;;
    RUN_SCRIPT=*) script="${arg#*=}" ;;
    FLOW_VARIANT=*) variant="${arg#*=}" ;;
    *=*|-C) ;;
    /*) ;;
    *) target="$arg" ;;
  esac
done
platform=$(sed -n 's/^export PLATFORM = //p' "$cfg")
nick=$(sed -n 's/^export DESIGN_NICKNAME = //p' "$cfg")
logs="$work/logs/$platform/$nick/$variant"
reports="$work/reports/$platform/$nick/$variant"
mode="${FAKE_MAKE:-ok}"
case "$target" in
  finish|synth)
    [ "$mode" = fail ] && exit 3
    [ "$mode" = faillog ] && { cat "$here/../flow_fail.log"; exit 2; }
    [ "$mode" = sleep ] && exec sleep 600
    if [ "$target" = synth ]; then
      [ "$mode" = missing ] && exit 0
      results="$work/results/$platform/$nick/$variant"
      mkdir -p "$results"
      printf 'module counter; endmodule\n' > "$results/1_2_yosys.v"
      printf 'fake database\n' > "$results/1_synth.odb"
      printf 'create_clock -period 8 [get_ports clk]\n' > "$results/1_synth.sdc"
      [ "$mode" = empty ] && : > "$results/1_synth.odb"
      [ "$mode" = errorzero ] && echo 'ERROR: frontend error despite exit zero'
      exit 0
    fi
    mkdir -p "$logs" "$reports"
    cp "$here"/logs/*.json "$logs/"
    cp "$here"/reports/6_finish.rpt "$here"/reports/synth_stat.txt "$reports/"
    ;;
  run)
    case "${script:-}" in
      */clock_slacks.tcl)
        [ "$mode" = clocksfail ] && exit 3
        [ "$mode" = clockssleep ] && exec sleep 600
        if [ "$mode" = noclocks ]; then
          printf '{"clocks": {}}\n' > "$reports/asic_clocks.json"
        else
          cp "$here"/reports/asic_clocks.json "$reports/"
        fi
        ;;
      *)
        [ "$mode" = noextra ] && exit 0
        cp "$here"/reports/asic_extra.json "$reports/"
        ;;
    esac
    ;;
  *) echo "fake make: unknown target $target" >&2; exit 2 ;;
esac
